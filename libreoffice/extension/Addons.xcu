<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">

    <!-- A "Review Tracker" menu in Writer's menu bar, before the Help menu -->
    <node oor:name="OfficeMenuBarMerging">
      <node oor:name="io.github.derrytaylor93.reviewtracker" oor:op="replace">
        <node oor:name="S1" oor:op="replace">
          <prop oor:name="MergePoint"><value>.uno:HelpMenu</value></prop>
          <prop oor:name="MergeCommand"><value>AddBefore</value></prop>
          <prop oor:name="MergeFallback"><value>AddPath</value></prop>
          <prop oor:name="MergeContext"><value>com.sun.star.text.TextDocument</value></prop>
          <node oor:name="MenuItems">
            <node oor:name="M1" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>io.github.derrytaylor93.reviewtracker:menu</value></prop>
              <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Re~view Tracker</value></prop>
              <node oor:name="Submenu">
          <node oor:name="m00" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:ReviewTracker.oxt|Scripts|python|ReviewTracker.py$track_selection?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Track Selection</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m01" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:ReviewTracker.oxt|Scripts|python|ReviewTracker.py$tracked_passages?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Tracked Passages...</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m02s" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
          </node>
          <node oor:name="m02" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:ReviewTracker.oxt|Scripts|python|ReviewTracker.py$insert_line_reference?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Insert Line Reference...</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m03" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:ReviewTracker.oxt|Scripts|python|ReviewTracker.py$update_line_numbers?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Update Line Numbers</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m04s" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
          </node>
          <node oor:name="m04" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:ReviewTracker.oxt|Scripts|python|ReviewTracker.py$finalise_document?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Remove Tracking from This Document...</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
              </node>
            </node>
          </node>
        </node>
      </node>
    </node>

    <!-- A "Review Tracker" toolbar (View > Toolbars > Review Tracker) -->
    <node oor:name="OfficeToolBar">
      <node oor:name="io.github.derrytaylor93.reviewtracker" oor:op="replace">
          <node oor:name="t00" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:ReviewTracker.oxt|Scripts|python|ReviewTracker.py$track_selection?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Track Selection</value></prop>
